# TLS proxy in front of the dashboard (`docker compose --profile web up -d web`, 127.0.0.1:8000).
# Replace the host name with your own. A free DuckDNS name (an A record to the server IP) or any domain works;
# Caddy gets a Let's Encrypt certificate by itself. Ports 80 and 443 must be open.
# Set PRICE_MONITOR_WEB_SECURE_COOKIE=1 in .env when the dashboard is served this way.
price-monitor-demo.duckdns.org {
	encode gzip
	reverse_proxy 127.0.0.1:8000
}
