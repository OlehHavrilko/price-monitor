# Copy to .env. Everything is optional: without it the monitor uses the local demo catalog.

# Telegram is switched on only when BOTH values are set.
# Token from @BotFather; IDs are numeric Telegram user IDs, comma-separated.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_IDS=

# Seconds between scheduled collections of the demo catalog (compose default: 60).
PRICE_MONITOR_INTERVAL_SECONDS=60

# Set to 1 to also collect books.toscrape.com (public practice site, ~40 s per collection).
PRICE_MONITOR_ENABLE_BOOKS=0

# Set to 1 to monitor the real shop (allo.ua, category "Fitness bands"): ~6 MB per collection, every 6 hours.
PRICE_MONITOR_ENABLE_ALLO=1
