# Copy to .env. Everything is optional: without it the monitor uses the local demo catalog.

# Telegram is switched on only when BOTH values are set.
# Token from @BotFather; IDs are numeric Telegram user IDs, comma-separated.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_IDS=

# Seconds between scheduled collections of the demo catalog (compose default: 60).
PRICE_MONITOR_INTERVAL_SECONDS=60

# Set to 1 to also collect books.toscrape.com (public practice site, ~40 s per collection).
PRICE_MONITOR_ENABLE_BOOKS=0

# Set to 1 to monitor a real shop: xcom.ua, category "FM transmitters" (2 light pages, 10 s apart, every 6 hours).
# Off by default so the demo runs without an external network.
PRICE_MONITOR_ENABLE_XCOM=0

# allo.ua (fitness bands) refuses datacenter addresses with HTTP 403: use it from a home connection only.
PRICE_MONITOR_ENABLE_ALLO=0

# Web dashboard (read-only), started with `docker compose --profile web up -d`, on http://127.0.0.1:8000.
# Required for the dashboard, at least 16 characters. Generate one, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PRICE_MONITOR_WEB_TOKEN=
# Set to 1 only when the dashboard is served over HTTPS (behind a TLS proxy): the cookie becomes Secure.
PRICE_MONITOR_WEB_SECURE_COOKIE=0
